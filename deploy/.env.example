# Copy to .env next to docker-compose.yml and adjust.

DSH_IMAGE_REPOSITORY=ghcr.io/aionrhine/deepseek-harness
DSH_IMAGE_VERSION=0.2.2-rc.1-r1

# 127.0.0.1 keeps both ports off the network. Use a private interface address
# (e.g. a tailnet IP) when you need remote access.
DSH_BIND_ADDRESS=127.0.0.1
DSH_WEB_PORT=3080
DSH_SSH_PORT=2222

# Empty disables the in-container sshd.
# Multiple keys: separate with \n inside the quotes.
DSH_SSH_AUTHORIZED_KEY=

# Keep 0 unless you want the model to drive a browser inside the container.
DSH_DESKTOP_ENABLED=0
